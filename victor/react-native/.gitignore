# Expo / React Native
node_modules/
.expo/
dist/
web-build/
*.log

# The built VM module (produced by `npm run build:wasm`)
web/elpian_rn.wasm
elpian_rn.wasm

# Native build artifacts
native/elpian-rn/target/

# Expo prebuild output (Continuous Native Generation — regenerated from app.json
# by `expo prebuild`; the CI APK build produces and then discards these).
/android/
/ios/

# Native VM shared libs, cross-compiled by CI into the elpian-rn module
modules/elpian-rn/android/src/main/jniLibs/

# Godot embed project editor cache (regenerated on pack)
modules/elpian-godot/godot-project/.godot/
modules/elpian-godot/godot-project/**/*.import
modules/elpian-godot/godot-project/bin/*.so

# Web build/test artifacts (built by build:web / test:web)
web/main.js
web/e2e-screenshot.png
