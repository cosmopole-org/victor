# Expo / React Native
node_modules/
.expo/
dist/
web-build/
*.log

# The built VM module (produced by `npm run build:wasm`)
web/elpian_rn.wasm
elpian_rn.wasm

# Native build artifacts
native/elpian-rn/target/

# Expo prebuild output (Continuous Native Generation — regenerated from app.json
# by `expo prebuild`; the CI APK build produces and then discards these).
/android/
/ios/

# Native VM shared libs, cross-compiled by CI into the elpian-rn module
modules/elpian-rn/android/src/main/jniLibs/

# Godot embed project editor cache (regenerated on pack)
modules/elpian-godot/godot-project/.godot/
modules/elpian-godot/godot-project/**/*.import
# GDExtension native libs (built by CI: Android .so, web .wasm side module)
modules/elpian-godot/godot-project/bin/
# Godot HTML5 export output (regenerated by the web-pages workflow)
modules/elpian-godot/godot-project/web-export/

# Web build/test artifacts (built by build:web / test:web)
web/main.js
web/e2e-screenshot.png
web/e2e-godot.png

# Godot HTML5 export runtime, served flat next to web/index.html (built by CI:
# emsdk + godot-cpp web + godot --export-release "Web"). Large binaries — never
# committed; the web-pages workflow regenerates them.
web/elpian_godot.js
web/elpian_godot.wasm
web/elpian_godot.side.wasm
web/elpian_godot.pck
web/elpian_godot.audio.worklet.js
web/elpian_godot.png
web/libelpian_godot.web.wasm32.wasm
